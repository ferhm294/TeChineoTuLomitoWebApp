@model MVC_TeChineoTuLomito.Models.Empleado

@{
    ViewData["Title"] = "Editar Empleado";
}

<h1>Editar</h1>

<h4>Empleado</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Identificación (deshabilitada + oculta) -->
            <div class="form-group">
                <label asp-for="identificacion" class="control-label">Identificación</label>
                <input asp-for="identificacion" class="form-control" disabled />
                <input type="hidden" asp-for="identificacion" />
                <span asp-validation-for="identificacion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="nombreCompleto" class="control-label">Nombre Completo</label>
                <input asp-for="nombreCompleto" class="form-control" />
                <span asp-validation-for="nombreCompleto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="fechaNacimiento" class="control-label">Fecha de Nacimiento</label>
                <input asp-for="fechaNacimiento" class="form-control" type="date" />
                <span asp-validation-for="fechaNacimiento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="fechaContratacion" class="control-label">Fecha de Contratación</label>
                <input asp-for="fechaContratacion" class="form-control" type="date" />
                <span asp-validation-for="fechaContratacion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="salarioXDia" class="control-label">Salario por Día (₡)</label>
                <input asp-for="salarioXDia" class="form-control" />
                <span asp-validation-for="salarioXDia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="fechaRetiro" class="control-label">Fecha de Retiro</label>
                <input asp-for="fechaRetiro" class="form-control" type="date" />
                <span asp-validation-for="fechaRetiro" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="tipoEmpleado" class="control-label">Tipo de Empleado</label>
                <select asp-for="tipoEmpleado" class="form-control">
                    <option value="veterinario">Veterinario</option>
                    <option value="asistente">Asistente</option>
                    <option value="administrativo">Administrativo</option>
                    <option value="mantenimiento">Mantenimiento</option>
                    <option value="groomer">Groomer</option>
                </select>
                <span asp-validation-for="tipoEmpleado" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
