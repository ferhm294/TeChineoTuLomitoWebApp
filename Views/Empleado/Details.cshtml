@model MVC_TeChineoTuLomito.Models.Empleado

@{
    ViewData["Title"] = "Detalles del Empleado";
}

<h1>Detalles</h1>
<h4>Empleado</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.identificacion)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.identificacion)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.nombreCompleto)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.nombreCompleto)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.fechaNacimiento)
    </dt>
    <dd class="col-sm-10">
        @Model.fechaNacimiento.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.fechaContratacion)
    </dt>
    <dd class="col-sm-10">
        @Model.fechaContratacion.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.salarioXDia)
    </dt>
    <dd class="col-sm-10">
        @("₡" + Model.salarioXDia.ToString("N0"))
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.fechaRetiro)
    </dt>
    <dd class="col-sm-10">
        @Model.fechaRetiro.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.tipoEmpleado)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.tipoEmpleado)
    </dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-identificacion="@Model.identificacion" class="btn btn-primary">Editar</a> |
    <a asp-action="Index">Volver a la lista</a>
</div>
