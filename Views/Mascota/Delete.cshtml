@model MVC_TeChineoTuLomito.Models.Mascota

@{
    ViewData["Title"] = "Eliminar Mascota";
}

<h1>Eliminar</h1>
<h4>Mascota</h4>
<h5>¿Seguro que deseas eliminar esta mascota?</h5>
<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.id)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.id)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.nombreMascota)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.nombreMascota)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.identificacionDueño)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.identificacionDueño)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.especie)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.especie)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.raza)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.raza)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.edad)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.edad)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.color)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.color)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.ultimaFechaAtencion)
    </dt>
    <dd class="col-sm-10">
        @Model.ultimaFechaAtencion.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.ultimaFechaVacunacion)
    </dt>
    <dd class="col-sm-10">
        @Model.ultimaFechaVacunacion.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.telefonoDueno)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.telefonoDueno)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.emailDueno)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.emailDueno)
    </dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="id" />
    <input type="submit" value="Eliminar" class="btn btn-danger" /> |
    <a asp-action="Index">Volver a la lista</a>
</form>
