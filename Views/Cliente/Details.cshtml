@model MVC_TeChineoTuLomito.Models.Cliente

@{
    ViewData["Title"] = "Detalles de Cliente";
}

<h1>Detalles</h1>

<div>
    <h4>Cliente</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.identificacion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.identificacion)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.nombreCompleto)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.nombreCompleto)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.provincia)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.provincia)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.canton)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.canton)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.distrito)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.distrito)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.direccionExacta)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.direccionExacta)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.telefono)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.telefono)
        </dd>

        <dt class="col-sm-2">
            Preferencia de Contacto
        </dt>
        <dd class="col-sm-10">
            @(Model.preferenciaContacto ? "Llamada" : "WhatsApp")
        </dd>
    </dl>
</div>

<div>
    @Html.ActionLink("Editar", "Edit", new { id = ViewBag.Index }) |
    <a asp-action="Index">Volver a la lista</a>
</div>
