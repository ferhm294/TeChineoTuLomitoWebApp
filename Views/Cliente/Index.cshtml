@model IEnumerable<MVC_TeChineoTuLomito.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes</h1>

<!-- 🔍 Formulario de búsqueda -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Buscar por nombre..." />
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Crear Cliente</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().identificacion)</th>
            <th>@Html.DisplayNameFor(model => model.First().nombreCompleto)</th>
            <th>@Html.DisplayNameFor(model => model.First().provincia)</th>
            <th>@Html.DisplayNameFor(model => model.First().canton)</th>
            <th>@Html.DisplayNameFor(model => model.First().distrito)</th>
            <th>@Html.DisplayNameFor(model => model.First().telefono)</th>
            <th>Preferencia</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.identificacion)</td>
                <td>@Html.DisplayFor(modelItem => item.nombreCompleto)</td>
                <td>@Html.DisplayFor(modelItem => item.provincia)</td>
                <td>@Html.DisplayFor(modelItem => item.canton)</td>
                <td>@Html.DisplayFor(modelItem => item.distrito)</td>
                <td>@Html.DisplayFor(modelItem => item.telefono)</td>
                <td>@(item.preferenciaContacto ? "Llamada" : "WhatsApp")</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { identificacion = item.identificacion }) |
                    @Html.ActionLink("Detalles", "Details", new { identificacion = item.identificacion }) |
                    @Html.ActionLink("Eliminar", "Delete", new { identificacion = item.identificacion })
                </td>
            </tr>
        }
    </tbody>
</table>
